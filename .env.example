# Copy this file to .env and fill in real values.
# .env is git ignored. This file is committed.
#
# Rule: whenever you add a key to .env, add it here with a safe placeholder.
# Otherwise the next person's setup fails silently.

# ----------------------------------------------------------------- runtime
# development or production. It decides one thing that matters: whether the
# session cookie is marked Secure. A browser will not store a Secure cookie from
# http://localhost, so signing in would silently do nothing in development.
NODE_ENV=development

# The port the API listens on. `npm run api`. Read since LMS 401 — before that
# there was no server entry point for it to mean anything to.
PORT=3000

# Base URL of the running app. Used in email links, so it must be the address
# a recipient can actually open, not localhost, once deployed.
#
# It is Vite's port rather than the API's on purpose: in development the browser
# talks to Vite on 5173, which proxies /api to PORT above. One origin, which is
# what lets the session cookie be SameSite=Strict and the API carry no CORS.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------- database
# Two connections, deliberately. The application runs as the restricted lms_app
# role, which has no rights it does not need and cannot UPDATE or DELETE the
# ledger or the audit log. NFR AUD 02.
#
# lms_app is created by a migration but its password is not, since a migration
# is committed and a password must not be. Set it once against the database:
#   ALTER ROLE lms_app WITH PASSWORD '...';
# then put the same value here. Rolling that migration back drops the role and
# the password with it, so both steps run again after a rollback.
DATABASE_URL=postgresql://lms_app:replace_me@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# The owner role. Runs migrations, owns every object, and is used by nothing
# else. Never point the running application at this one.
#
# Use the DIRECT endpoint, not the pooled one. The pooled host has "-pooler" in
# it, and the session advisory lock that stops two migration runs colliding does
# not survive a transaction pooler.
DATABASE_MIGRATION_URL=postgresql://neondb_owner:replace_me@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# A separate Neon branch for integration tests. Direct endpoint, as above.
# Leave blank unless you are running them.
DATABASE_URL_BRANCH=

# Where integration tests build and drop their disposable database. The owner
# connection, and PostgreSQL 17 as everywhere else.
#
# Point this at your LOCAL Postgres 17. Every test reloads the fixture
# organisation, so the suite is several thousand round trips: over a network that
# is eleven minutes, and locally it is under one. The database does the same work
# either way — the network is the whole difference.
#
# Falls back to DATABASE_MIGRATION_URL when blank, so continuous integration and
# anybody without a local server carry on unchanged. It is a key of its own so
# that migrations still go to Neon while tests stay local.
#
# On Windows, 17 installed beside a newer version is usually on 5433. Check with:
#   Select-String -Path "C:\Program Files\PostgreSQL\17\data\postgresql.conf" -Pattern "^port"
TEST_DATABASE_URL=postgresql://postgres:replace_me@localhost:5433/postgres

# ---------------------------------------------------------- authentication
# Generate with:  openssl rand -base64 32
#
# Read since LMS 401, which brought the route layer this was always waiting for.
# It signs the session cookie — an employee id, when it was issued, and an HMAC
# over both, and deliberately no roles: those are read from the database on every
# request so that closing an account takes effect on the next one.
#
# There is no default and there must not be one. A default signing key is a
# system that runs perfectly well in production while anybody can mint a cookie
# for anybody, and it fails silently. server/src/routes/session-cookie.ts refuses
# to start without this, refuses the placeholder below, and refuses anything
# under 32 characters.
SESSION_SECRET=replace_me_with_a_long_random_string

# Sign in is by company email only. Comma separated. NFR SEC 01.
# Anything outside this list is rejected at provisioning and at login, which
# are two separate doors into the same building.
#
# Decided for Remat Holdings: rematholdings.com, and nothing else.
#
# Matching is exact. hr.rematholdings.com is a different domain and is refused
# unless somebody adds it here deliberately, because anyone able to create a
# subdomain could otherwise mint themselves a company identity.
#
# An empty value is not "no restriction": the application refuses to start,
# because there is no safe way to read an empty allow list.
ALLOWED_EMAIL_DOMAINS=rematholdings.com

# One time code sent to the company address. NFR SEC 01.
#
# Mandatory for HR Officer, HR Administrator and System Administrator, which is
# decided from the roles somebody holds and is not configurable here. Everybody
# else may turn it on for themselves.
#
# Unlike ALLOWED_EMAIL_DOMAINS, leaving these blank is safe and means the values
# below: there is a usual code length and a usual lifetime, and neither is a
# decision somebody has to make before the system will start.
#
# A value that is present and nonsense is refused rather than used. Both are
# bounded — 4 to 12 digits, 1 to 60 minutes — because the failure that matters is
# the quiet one: a length of 1 read from a typo is a ten possibility second factor
# that looks exactly like a working one.
MFA_CODE_TTL_MINUTES=10
MFA_CODE_LENGTH=6

# --------------------------------------------------------------------- mail
# Development points at Mailpit, which catches everything locally.
# Production points at company email or a sending service.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

MAIL_FROM_NAME=Remat Holdings Leave
MAIL_FROM_ADDRESS=leave@rematholdings.com

# Safety net. When set, every outbound email goes here instead of the real
# recipient. Leave blank in production. Use it if you ever point a non
# production environment at real staff addresses.
MAIL_OVERRIDE_RECIPIENT=

# ----------------------------------------------------------------- storage
# Attachments never go in the database or under the web root.
# Local development writes to a directory. Production uses object storage
# in the same region as the database.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage

STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Signed download links are short lived. NFR SEC 04.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# ------------------------------------------------------------------ scanning
# Every attachment is scanned before it can be downloaded or stand as evidence.
# NFR SEC 07.
#
# "signature" is development's: it flags the EICAR test file and calls everything
# else clean. It is not antivirus, and production must not run it.
# "off" answers nothing, so every upload stays PENDING — unopenable, and it
# satisfies no documentation requirement.
SCANNER_DRIVER=signature

# ------------------------------------------------------------------- limits
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=5
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ------------------------------------------------------------ dates and times
# The zone instants are shown to people in. NFR DAT 03.
#
# Display only, and the name is the promise. Every timestamp is stored in UTC and
# every leave date is a calendar date with no time and no zone on it, so changing
# this changes what a screen says and not one row in the database. There is
# nothing to migrate and nothing to recalculate.
#
# An IANA name. Blank means Africa/Accra, which is where the company is. A name
# this Node does not know is refused rather than quietly falling back, because
# Africa/Akkra silently becoming Accra is right this once and wrong the day
# somebody sets Europe/Lisbon and means it.
#
# It is one zone for the company rather than one per person, deliberately:
# somebody travelling wants their leave to read the same as it does to the
# colleague approving it.
DISPLAY_TIMEZONE=Africa/Accra

# ---------------------------------------------------------------- scheduling
# Daily approver reminders. FR 50.
JOBS_ENABLED=true
REMINDER_CRON=0 8 * * *

# ------------------------------------------------------------------ logging
LOG_LEVEL=debug
