# Copy this file to .env and fill in real values.
# .env is git ignored. This file is committed.
#
# Rule: whenever you add a key to .env, add it here with a safe placeholder.
# Otherwise the next person's setup fails silently.

# ----------------------------------------------------------------- runtime
NODE_ENV=development
PORT=3000

# Base URL of the running app. Used in email links, so it must be the address
# a recipient can actually open, not localhost, once deployed.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------- database
# Local development. Match the Postgres major version you run in production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/lms_dev

# Neon, for integration tests and staging. Use the pooled connection string.
# Leave blank locally.
DATABASE_URL_BRANCH=

# ---------------------------------------------------------- authentication
# Generate with:  openssl rand -base64 32
SESSION_SECRET=replace_me_with_a_long_random_string

# Sign in is by company email only. Comma separated, no spaces.
# Anything outside this list is rejected at provisioning and at login.
ALLOWED_EMAIL_DOMAINS=rematholdings.com

# One time code sent to the company address. NFR SEC 01.
MFA_CODE_TTL_MINUTES=10
MFA_CODE_LENGTH=6

# --------------------------------------------------------------------- mail
# Development points at Mailpit, which catches everything locally.
# Production points at company email or a sending service.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

MAIL_FROM_NAME=Remat Holdings Leave
MAIL_FROM_ADDRESS=leave@rematholdings.com

# Safety net. When set, every outbound email goes here instead of the real
# recipient. Leave blank in production. Use it if you ever point a non
# production environment at real staff addresses.
MAIL_OVERRIDE_RECIPIENT=

# ----------------------------------------------------------------- storage
# Attachments never go in the database or under the web root.
# Local development writes to a directory. Production uses object storage
# in the same region as the database.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage

STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Signed download links are short lived. NFR SEC 04.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# ------------------------------------------------------------------- limits
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=5
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ---------------------------------------------------------------- scheduling
# Timestamps are stored in UTC. This is display only. NFR DAT 03.
DISPLAY_TIMEZONE=Africa/Accra

# Daily approver reminders. FR 50.
JOBS_ENABLED=true
REMINDER_CRON=0 8 * * *

# ------------------------------------------------------------------ logging
LOG_LEVEL=debug
